{
  "name": "blackcatacademy/blackcat-jwt",
  "description": "JWT helpers + DB revocation store integration for the BlackCat ecosystem.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "psr/log": "^3.0",
    "blackcatacademy/blackcat-core": "dev-dev",
    "blackcatacademy/blackcat-database": "dev-dev"
  },
  "autoload": {
    "psr-4": {
      "BlackCat\\Jwt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackCat\\Jwt\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

